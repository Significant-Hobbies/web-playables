---
// Features — pulled from AGENTS.md "Purpose" + "Stack".
//
// Three columns. Each is a short headline + one-sentence supporting
// line. Kept terse on purpose — landing copy, not feature docs.
const FEATURES = [
  {
    n: 'I',
    t: 'Multi-provider AI',
    b: 'Use the keyless free option on the web, bring an Anthropic, OpenAI, Gemini, or DeepSeek key, or connect a local provider when self-hosting.',
    accent: 'amber',
  },
  {
    n: 'II',
    t: 'Save & resume',
    b: 'Play without an account using local saves. Sign in only if you want private cloud saves that follow you across devices.',
    accent: 'emerald',
  },
  {
    n: 'III',
    t: 'Alternate history',
    b: 'Rewind to an earlier turn and create a new branch. The Game Master rolls the world forward from your changed decision.',
    accent: 'rose',
  },
] as const;
---

<section class="oh-features">
  <div class="oh-eyebrow center">&middot;&nbsp; FEATURES &nbsp;&middot;</div>
  <h2 class="oh-h2 center">
    The working loop. <em>Still an experiment.</em>
  </h2>
  <div class="oh-features-grid">
    {FEATURES.map((f) => (
      <article class={`oh-feature oh-feature-${f.accent}`}>
        <div class="oh-feature-num">{f.n}</div>
        <div class="oh-feature-rule" aria-hidden="true"></div>
        <h3 class="oh-feature-title">{f.t}</h3>
        <p class="oh-feature-body">{f.b}</p>
      </article>
    ))}
  </div>
</section>
